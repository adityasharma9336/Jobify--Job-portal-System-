{
  "name": "jobify",
  "version": "1.0.0",
  "description": "Jobify — Full-stack Job Platform (MERN)",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "lint:server": "cd server && npx eslint . --ext .js",
    "lint:client": "cd client && npx eslint . --ext .jsx,.js",
    "lint": "npm run lint:server && npm run lint:client",
    "audit:server": "cd server && npm audit --audit-level=high",
    "audit:client": "cd client && npm audit --audit-level=high",
    "audit": "npm run audit:server && npm run audit:client",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down -v",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0"
  },
  "lint-staged": {
    "server/**/*.js": [
      "npx eslint --fix"
    ],
    "client/**/*.{js,jsx}": [
      "npx eslint --fix"
    ]
  }
}
